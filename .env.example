NODE_ENV=development
API_PORT=3333
DATABASE_URL=file:./prisma/dev.db
WEB_ORIGIN=http://localhost:5174

# Gere um valor longo e aleatório (mín. 32 caracteres em produção)
JWT_SECRET=

# Obrigatório para npm run prisma:seed e bootstrap opcional da API
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Ederson Programador

# Opcional: usuários de teste locais (somente development)
SEED_DEMO_USERS=false
SEED_DEMO_PASSWORD=

# Em produção, bootstrap do admin só roda se ADMIN_BOOTSTRAP=true
ADMIN_BOOTSTRAP=false

# Front (Vercel): URL pública da API
# VITE_API_URL=

# Front: link externo de agendamento (Cal.com, Google Calendar, etc.)
# VITE_MEETING_URL=
