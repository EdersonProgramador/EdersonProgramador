NODE_ENV=development
API_PORT=3333
# Postgres (local: Docker/Neon ou URL do Render após o Blueprint)
# Postgres (não use file: — o schema Prisma é postgresql)
# Windows: senha definida na instalação do PostgreSQL 17 (porta 5432). Depois: npm run setup:local
LOCAL_POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ederson_agencia?schema=public
WEB_ORIGIN=http://localhost:5174,http://127.0.0.1:5174

# Gere um valor longo e aleatório (mín. 32 caracteres em produção)
JWT_SECRET=

# Obrigatório para npm run prisma:seed e bootstrap opcional da API
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Ederson Programador

# Opcional: usuários de teste locais (somente development)
SEED_DEMO_USERS=false
SEED_DEMO_PASSWORD=

# Em produção, bootstrap do admin só roda se ADMIN_BOOTSTRAP=true
ADMIN_BOOTSTRAP=false

# Produção: sincroniza aluno@gmail.com (senha padrão 123465 ou ACADEMY_TEST_ALUNO_PASSWORD)
# ACADEMY_SYNC_TEST_ALUNO=true
# ACADEMY_TEST_ALUNO_PASSWORD=123465

# Cursos FL: pasta media/ do portal Desktop\FL (vídeos e PDFs) — só na API
# FL_MEDIA_ROOT=C:\Users\EDERSON\Desktop\FL\media

# Front (Vercel): URL pública da API (com https://). Se vazio no dev, o Vite faz proxy.
# VITE_API_URL=https://ederson-agencia-api.onrender.com

# Dev (Vite proxy): API alvo quando VITE_API_URL não está definido. Padrão = Render.
# VITE_DEV_API_TARGET=https://ederson-agencia-api.onrender.com
# VITE_DEV_API_TARGET=http://127.0.0.1:3333
# VITE_DEV_API_USE_LOCAL=true
# Não use VITE_API_URL=http://127.0.0.1:3333 no browser sem Postgres local — deixe vazio e use o proxy.

# Front: link externo de agendamento (Cal.com, Google Calendar, etc.)
# VITE_MEETING_URL=
