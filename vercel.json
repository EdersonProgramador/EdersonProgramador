{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm install --workspace=@ederson-agencia/web --workspace=@ederson-agencia/shared --include-workspace-root",
  "buildCommand": "npm run build --workspace=@ederson-agencia/shared && npm run build --workspace=@ederson-agencia/web",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [{ "source": "/((?!assets/|.*\\.pdf$).*)", "destination": "/index.html" }]
}
