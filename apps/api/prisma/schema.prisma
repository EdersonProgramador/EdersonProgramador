generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("CLIENT")
  status       String   @default("ACTIVE")
  company      String?
  github       String?
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clientProjects     Project[] @relation("ClientProjects")
  freelancerProjects Project[] @relation("FreelancerProjects")
  leadsAssigned      Lead[]
  courseEnrollments  CourseEnrollment[]
  lessonProgress     LessonProgress[]
  courseOrders       CourseOrder[]
  courseCertificates CourseCertificate[]
  lessonNotes        StudyLessonNote[]
  moduleFichamentos  StudyModuleFichamento[]
  courseFichamentos  StudyCourseFichamento[]
  libraryReading     CourseLibraryReading[]
}

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String?
  status      String   @default("DRAFT")
  visibility  String   @default("INTERNAL")
  priceCents  Int?
  currency    String   @default("BRL")
  contentKey  String?
  coverUrl    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments CourseEnrollment[]
  progress    LessonProgress[]
  orders      CourseOrder[]
  modules       CourseModule[]
  certificates      CourseCertificate[]
  studyLessonNotes  StudyLessonNote[]
  studyModuleFich   StudyModuleFichamento[]
  studyCourseFich   StudyCourseFichamento[]
  libraryBooks      CourseLibraryBook[]
}

model CourseModule {
  id        String         @id @default(cuid())
  courseId  String
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sortOrder Int            @default(0)
  title     String
  lessons   CourseLesson[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([courseId, sortOrder])
}

model CourseLesson {
  id          String       @id @default(cuid())
  moduleId    String
  module      CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  slug        String
  lessonKey   String?
  sortOrder   Int          @default(0)
  title       String
  lessonType  String       @default("article")
  status      String       @default("DRAFT")
  bodyHtml    String?
  videoUrl    String?
  documentUrl String?
  telegramRef String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([moduleId, slug])
  @@index([moduleId, sortOrder])
}

model CourseEnrollment {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  source    String    @default("INTERNAL")
  status    String    @default("ACTIVE")
  orderId   String?
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@unique([userId, courseId])
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonSlug  String
  completedAt DateTime @default(now())

  @@unique([userId, courseId, lessonSlug])
}

model CourseCertificate {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId         String
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  verificationCode String   @unique
  issuedAt         DateTime @default(now())
  completedAt      DateTime
  lessonCount      Int

  @@unique([userId, courseId])
}

model StudyLessonNote {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonSlug String
  docJson    String?
  docHtml    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, courseId, lessonSlug])
}

model StudyModuleFichamento {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId     String
  course       Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleNumber Int
  moduleTitle  String?
  docJson      String?
  docHtml      String?
  compiledAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, courseId, moduleNumber])
}

model CourseLibraryBook {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  slug      String
  title     String
  subtitle  String?
  author    String?
  summary   String?
  coverUrl  String?
  pdfUrl    String
  pageCount Int?
  sortOrder Int      @default(0)
  status    String   @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  readings CourseLibraryReading[]

  @@unique([courseId, slug])
  @@index([courseId, sortOrder])
}

model CourseLibraryReading {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  bookId    String
  book      CourseLibraryBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  lastPage  Int      @default(1)
  updatedAt DateTime @updatedAt

  @@unique([userId, bookId])
  @@index([userId, courseId])
}

model StudyCourseFichamento {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  docJson    String?
  docHtml    String?
  compiledAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, courseId])
}

model CourseOrder {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  amountCents   Int
  status        String    @default("PENDING")
  paymentMethod String?
  provider      String?
  providerRef   String?
  createdAt     DateTime  @default(now())
  paidAt        DateTime?
}

model Lead {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  company     String?
  message     String
  budgetHint  String?
  packageTier String?
  status      String   @default("NEW")
  source      String?  @default("landing")
  assigneeId  String?
  assignee    User?    @relation(fields: [assigneeId], references: [id])
  projectId   String?  @unique
  project     Project? @relation(fields: [projectId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id              String   @id @default(cuid())
  title           String
  description     String?
  status          String   @default("DRAFT")
  paymentStatus   String   @default("PENDING")
  totalValueCents Int      @default(300000)
  entryValueCents Int      @default(150000)
  packageTier     String   @default("professional")
  clientId        String
  client          User     @relation("ClientProjects", fields: [clientId], references: [id])
  freelancerId    String?
  freelancer      User?    @relation("FreelancerProjects", fields: [freelancerId], references: [id])
  lead            Lead?
  phases           ProjectPhase[]
  upgradeRequests  ProjectUpgradeRequest[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ProjectUpgradeRequest {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromTier      String
  toTier        String
  status        String   @default("PENDING")
  clientMessage String?
  adminNote     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId, status])
}

model ProjectPhase {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseKey    String
  label       String
  sortOrder   Int
  daysPlanned Int
  status      String    @default("PENDING")
  notes       String?
  approvedAt    DateTime?
  deliverables  ProjectPhaseDeliverable[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([projectId, phaseKey])
}

model ProjectPhaseDeliverable {
  id          String       @id @default(cuid())
  phaseId     String
  phase       ProjectPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  label       String
  sortOrder   Int          @default(0)
  status      String       @default("PENDING")
  feedbackNote String?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([phaseId, sortOrder])
}
