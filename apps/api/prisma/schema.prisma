generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("CLIENT")
  status       String   @default("ACTIVE")
  company      String?
  github       String?
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clientProjects     Project[] @relation("ClientProjects")
  freelancerProjects Project[] @relation("FreelancerProjects")
  leadsAssigned      Lead[]
  courseEnrollments  CourseEnrollment[]
  lessonProgress     LessonProgress[]
  courseOrders       CourseOrder[]
}

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String?
  status      String   @default("DRAFT")
  visibility  String   @default("INTERNAL")
  priceCents  Int?
  currency    String   @default("BRL")
  contentKey  String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments CourseEnrollment[]
  progress    LessonProgress[]
  orders      CourseOrder[]
  modules     CourseModule[]
}

model CourseModule {
  id        String         @id @default(cuid())
  courseId  String
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sortOrder Int            @default(0)
  title     String
  lessons   CourseLesson[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([courseId, sortOrder])
}

model CourseLesson {
  id          String       @id @default(cuid())
  moduleId    String
  module      CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  slug        String
  lessonKey   String?
  sortOrder   Int          @default(0)
  title       String
  lessonType  String       @default("article")
  status      String       @default("DRAFT")
  bodyHtml    String?
  videoUrl    String?
  documentUrl String?
  telegramRef String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([moduleId, slug])
  @@index([moduleId, sortOrder])
}

model CourseEnrollment {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  source    String    @default("INTERNAL")
  status    String    @default("ACTIVE")
  orderId   String?
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@unique([userId, courseId])
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonSlug  String
  completedAt DateTime @default(now())

  @@unique([userId, courseId, lessonSlug])
}

model CourseOrder {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  amountCents   Int
  status        String    @default("PENDING")
  paymentMethod String?
  provider      String?
  providerRef   String?
  createdAt     DateTime  @default(now())
  paidAt        DateTime?
}

model Lead {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  company     String?
  message     String
  budgetHint  String?
  status      String   @default("NEW")
  source      String?  @default("landing")
  assigneeId  String?
  assignee    User?    @relation(fields: [assigneeId], references: [id])
  projectId   String?  @unique
  project     Project? @relation(fields: [projectId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id              String   @id @default(cuid())
  title           String
  description     String?
  status          String   @default("DRAFT")
  paymentStatus   String   @default("PENDING")
  totalValueCents Int      @default(300000)
  entryValueCents Int      @default(150000)
  clientId        String
  client          User     @relation("ClientProjects", fields: [clientId], references: [id])
  freelancerId    String?
  freelancer      User?    @relation("FreelancerProjects", fields: [freelancerId], references: [id])
  lead            Lead?
  phases          ProjectPhase[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ProjectPhase {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseKey    String
  label       String
  sortOrder   Int
  daysPlanned Int
  status      String    @default("PENDING")
  notes       String?
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([projectId, phaseKey])
}
