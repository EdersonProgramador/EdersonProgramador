generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("CLIENT")
  status       String   @default("ACTIVE")
  company      String?
  github       String?
  phone        String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clientProjects     Project[] @relation("ClientProjects")
  freelancerProjects Project[] @relation("FreelancerProjects")
  leadsAssigned      Lead[] @relation("LeadAssignee")
  courseEnrollments  CourseEnrollment[]
  lessonProgress     LessonProgress[]
  courseOrders       CourseOrder[]
  courseCertificates CourseCertificate[]
  lessonNotes        StudyLessonNote[]
  moduleFichamentos  StudyModuleFichamento[]
  courseFichamentos  StudyCourseFichamento[]
  libraryReading     CourseLibraryReading[]
  courseStudyStates  CourseUserStudyState[]
  repetitionCompletions CourseRepetitionCompletion[]
  moduleStudyStates  CourseModuleUserStudyState[]
  moduleRepetitionCompletions CourseModuleRepetitionCompletion[]
  leadProfile                 Lead? @relation("LeadUser")
  agencyNotifications         AgencyNotification[]
}

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String?
  status      String   @default("DRAFT")
  visibility  String   @default("INTERNAL")
  priceCents  Int?
  currency    String   @default("BRL")
  contentKey  String?
  coverUrl    String?
  sortOrder           Int      @default(0)
  repetitionGoalMax   Int?
  salesPage           Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments CourseEnrollment[]
  studyStates CourseUserStudyState[]
  repetitionCompletions CourseRepetitionCompletion[]
  progress    LessonProgress[]
  orders      CourseOrder[]
  modules       CourseModule[]
  certificates      CourseCertificate[]
  studyLessonNotes  StudyLessonNote[]
  studyModuleFich   StudyModuleFichamento[]
  studyCourseFich   StudyCourseFichamento[]
  libraryBooks      CourseLibraryBook[]
}

model CourseModule {
  id        String         @id @default(cuid())
  courseId  String
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sortOrder Int            @default(0)
  title     String
  lessons   CourseLesson[]
  moduleStudyStates CourseModuleUserStudyState[]
  moduleRepetitionCompletions CourseModuleRepetitionCompletion[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([courseId, sortOrder])
}

model CourseLesson {
  id          String       @id @default(cuid())
  moduleId    String
  module      CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  slug        String
  lessonKey   String?
  sortOrder   Int          @default(0)
  title       String
  lessonType  String       @default("article")
  status      String       @default("DRAFT")
  bodyHtml           String?
  videoUrl           String?
  documentUrl        String?
  telegramRef      String?
  sectionTitle     String?
  sectionSortOrder Int          @default(1)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([moduleId, slug])
  @@index([moduleId, sortOrder])
}

model CourseEnrollment {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  source    String    @default("INTERNAL")
  status    String    @default("ACTIVE")
  orderId   String?
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@unique([userId, courseId])
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonSlug  String
  completedAt DateTime @default(now())

  @@unique([userId, courseId, lessonSlug])
}

model CourseUserStudyState {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId              String
  course                Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  activeRepetitionCycle Int      @default(1)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([courseId])
}

model CourseRepetitionCompletion {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  cycleNumber Int
  completedAt DateTime @default(now())
  lessonCount Int

  @@unique([userId, courseId, cycleNumber])
  @@index([courseId])
}

model CourseModuleUserStudyState {
  id                    String       @id @default(cuid())
  userId                String
  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId              String
  module                CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  activeRepetitionCycle Int          @default(1)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@unique([userId, moduleId])
  @@index([moduleId])
}

model CourseModuleRepetitionCompletion {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId    String
  module      CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  cycleNumber Int
  completedAt DateTime     @default(now())
  lessonCount Int

  @@unique([userId, moduleId, cycleNumber])
  @@index([moduleId])
}

model CourseCertificate {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId         String
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  verificationCode String   @unique
  issuedAt         DateTime @default(now())
  completedAt      DateTime
  lessonCount      Int

  @@unique([userId, courseId])
}

model StudyLessonNote {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonSlug String
  docJson    String?
  docHtml    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, courseId, lessonSlug])
}

model StudyModuleFichamento {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId     String
  course       Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleNumber Int
  moduleTitle  String?
  docJson      String?
  docHtml      String?
  compiledAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, courseId, moduleNumber])
}

model CourseLibraryBook {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  slug      String
  title     String
  subtitle  String?
  author    String?
  summary   String?
  coverUrl  String?
  pdfUrl    String
  pageCount Int?
  sortOrder Int      @default(0)
  status    String   @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  readings CourseLibraryReading[]

  @@unique([courseId, slug])
  @@index([courseId, sortOrder])
}

model CourseLibraryReading {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  bookId    String
  book      CourseLibraryBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  lastPage  Int      @default(1)
  updatedAt DateTime @updatedAt

  @@unique([userId, bookId])
  @@index([userId, courseId])
}

model StudyCourseFichamento {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  docJson    String?
  docHtml    String?
  compiledAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, courseId])
}

model CourseOrder {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  amountCents   Int
  status        String    @default("PENDING")
  paymentMethod String?
  provider      String?
  providerRef   String?
  createdAt     DateTime  @default(now())
  paidAt        DateTime?
}

model Lead {
  id              String    @id @default(cuid())
  name            String
  email           String
  phone           String?
  company         String?
  message         String
  budgetHint      String?
  packageTier     String?
  status          String    @default("NEW")
  source          String?   @default("landing")
  liveAttended    Boolean   @default(false)
  liveAttendedAt  DateTime?
  userId          String?   @unique
  user            User?     @relation("LeadUser", fields: [userId], references: [id], onDelete: SetNull)
  assigneeId      String?
  assignee        User?     @relation("LeadAssignee", fields: [assigneeId], references: [id])
  projectId       String?   @unique
  project         Project?  @relation(fields: [projectId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([email])
}

model Project {
  id              String   @id @default(cuid())
  title           String
  description     String?
  status          String   @default("DRAFT")
  paymentStatus   String   @default("PENDING")
  totalValueCents Int      @default(300000)
  entryValueCents Int      @default(150000)
  packageTier            String    @default("professional")
  contractStatus         String    @default("NONE")
  contractSignedAt       DateTime?
  contractAcceptedName   String?
  contractVersion        String    @default("app-zero-v1")
  clientId        String
  client          User     @relation("ClientProjects", fields: [clientId], references: [id])
  freelancerId    String?
  freelancer      User?    @relation("FreelancerProjects", fields: [freelancerId], references: [id])
  lead            Lead?
  phases           ProjectPhase[]
  upgradeRequests  ProjectUpgradeRequest[]
  notifications    AgencyNotification[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AgencyFunnelConfig {
  id                  String    @id @default("default")
  livePublished       Boolean   @default(false)
  liveTitle           String    @default("Aula ao vivo — App do Zero ao Lançamento")
  liveSubtitle        String?
  liveScheduledAt     DateTime?
  liveStreamUrl       String?
  liveReplayUrl       String?
  packagesJson        Json?
  contractIntro       String?
  contractClausesJson Json?
  checkoutTitle       String?
  checkoutBody        String?
  checkoutPixKey      String?
  updatedAt           DateTime  @updatedAt
}

model AgencyNotification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  kind      String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([projectId])
}

model ProjectUpgradeRequest {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromTier      String
  toTier        String
  status        String   @default("PENDING")
  clientMessage String?
  adminNote     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId, status])
}

model ProjectPhase {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseKey    String
  label       String
  sortOrder   Int
  daysPlanned Int
  status      String    @default("PENDING")
  notes       String?
  approvedAt    DateTime?
  deliverables  ProjectPhaseDeliverable[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([projectId, phaseKey])
}

model ProjectPhaseDeliverable {
  id          String       @id @default(cuid())
  phaseId     String
  phase       ProjectPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  label       String
  sortOrder   Int          @default(0)
  status      String       @default("PENDING")
  feedbackNote String?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([phaseId, sortOrder])
}
